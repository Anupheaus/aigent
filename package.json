{
  "name": "@anupheaus/aigent",
  "version": "0.0.1",
  "description": "TypeScript framework for AI tools, context, prompt, and memory orchestration",
  "keywords": [
    "ai",
    "agent",
    "typescript",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anupheaus/aigent.git"
  },
  "homepage": "https://github.com/Anupheaus/aigent#readme",
  "bugs": {
    "url": "https://github.com/Anupheaus/aigent/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/contract": {
      "types": "./dist/testing/contract/index.d.ts",
      "import": "./dist/testing/contract/index.js"
    },
    "./tools/fs": {
      "types": "./dist/tools/packs/fs/index.d.ts",
      "import": "./dist/tools/packs/fs/index.js"
    },
    "./tools/data": {
      "types": "./dist/tools/packs/data/index.d.ts",
      "import": "./dist/tools/packs/data/index.js"
    },
    "./tools/meta": {
      "types": "./dist/tools/packs/meta/index.d.ts",
      "import": "./dist/tools/packs/meta/index.js"
    },
    "./tools/web": {
      "types": "./dist/tools/packs/web/index.d.ts",
      "import": "./dist/tools/packs/web/index.js"
    },
    "./tools/code": {
      "types": "./dist/tools/packs/code/index.d.ts",
      "import": "./dist/tools/packs/code/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0 <8",
    "vitest": ">=3.0.0 <5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
